{
  "openapi": "3.0.1",
  "info": {
    "title": "TLP Auctions API",
    "description": "RESTful API for EverQuest Time-Locked Progression server auction data",
    "contact": {
      "name": "TLP Auctions",
      "url": "https://tlp-auctions.com"
    },
    "version": "v3.0"
  },
  "paths": {
    "/api/items/{itemId}/history/{serverName}": {
      "get": {
        "tags": [
          "ItemHistory"
        ],
        "summary": "Get price history for a specific item on a server",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "description": "Item ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "serverName",
            "in": "path",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns price history, or null if no data exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceHistoryDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/krono-prices": {
      "get": {
        "tags": [
          "KronoPrices"
        ],
        "summary": "Get Krono prices for all servers",
        "responses": {
          "200": {
            "description": "Returns all server krono prices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllKronoPricesDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/krono-prices/{serverName}": {
      "get": {
        "tags": [
          "KronoPrices"
        ],
        "summary": "Get Krono price for a specific server",
        "parameters": [
          {
            "name": "serverName",
            "in": "path",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns server krono price, or null if no data exists yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KronoPriceDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/prices": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Get average price for an item",
        "parameters": [
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "description": "Item name to price check",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns average price",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceCheckDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name or missing item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No price data found for item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/prices/detailed": {
      "get": {
        "tags": [
          "Prices"
        ],
        "summary": "Get detailed price breakdown (buy vs sell) for an item\r\nReturns actual sales records separated by buy/sell transactions",
        "parameters": [
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "description": "Item name to price check",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns detailed price data with all matching sales",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedPriceCheckDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name or missing item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "No price data found for item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/raw-logs/{guid}": {
      "get": {
        "tags": [
          "RawLogs"
        ],
        "summary": "Get raw chat log text by GUID",
        "parameters": [
          {
            "name": "guid",
            "in": "path",
            "description": "Raw log GUID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns raw log text",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RawLogDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name or GUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Raw log not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sales": {
      "get": {
        "tags": [
          "Sales"
        ],
        "summary": "Get paginated sales logs with optional filtering",
        "parameters": [
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "description": "Item name to search for (case-insensitive partial match)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isBuy",
            "in": "query",
            "description": "Transaction type filter: true for WTB (buy), false for WTS (sell), null for both",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "exactMatch",
            "in": "query",
            "description": "If true, exact match on item name. Default: false",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number (1-indexed). Default: 1",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Results per page (max 1000). Default: 100",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          },
          {
            "name": "slots",
            "in": "query",
            "description": "Comma-separated list of equipment slots (head, chest, back, etc.) or special types (bags, spells, krono)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stats",
            "in": "query",
            "description": "Comma-separated list of stat filters (ac, hp, mana, haste, etc.) - filters items with stat > 0",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns paginated sales data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesLogDtoPagedResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/sales/{id}": {
      "get": {
        "tags": [
          "Sales"
        ],
        "summary": "Get a specific sale by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Sale log ID",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name to filter by",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns sale details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesLogDto"
                }
              }
            }
          },
          "404": {
            "description": "Sale not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/vendors/{name}/sales": {
      "get": {
        "tags": [
          "Vendors"
        ],
        "summary": "Get all sales from a specific vendor/auctioneer",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "Auctioneer character name (case-insensitive)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "serverName",
            "in": "query",
            "description": "Server name (Teek, Yelinak, Mischief, Thornblade, Oakwynd, Frostreaver)",
            "schema": {
              "type": "string",
              "default": "Teek"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns vendor sales",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SalesLogDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid server name or parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AllKronoPricesDto": {
        "type": "object",
        "properties": {
          "prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KronoPriceDto"
            },
            "nullable": true
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "DetailedPriceCheckDto": {
        "type": "object",
        "properties": {
          "serverName": {
            "type": "string",
            "nullable": true
          },
          "item": {
            "type": "string",
            "nullable": true
          },
          "buySales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesLogDto"
            },
            "nullable": true
          },
          "sellSales": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesLogDto"
            },
            "nullable": true
          },
          "totalBuySales": {
            "type": "integer",
            "format": "int32"
          },
          "totalSellSales": {
            "type": "integer",
            "format": "int32"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "KronoPriceDto": {
        "type": "object",
        "properties": {
          "serverName": {
            "type": "string",
            "nullable": true
          },
          "averagePrice": {
            "type": "number",
            "format": "double"
          },
          "sampleSize": {
            "type": "integer",
            "format": "int32"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PriceCheckDto": {
        "type": "object",
        "properties": {
          "serverName": {
            "type": "string",
            "nullable": true
          },
          "item": {
            "type": "string",
            "nullable": true
          },
          "averagePlatPrice": {
            "type": "number",
            "format": "double"
          },
          "averageKronoPrice": {
            "type": "number",
            "format": "double"
          },
          "sampleSize": {
            "type": "integer",
            "format": "int32"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "buyPrices": {
            "$ref": "#/components/schemas/PriceCheckDto"
          },
          "sellPrices": {
            "$ref": "#/components/schemas/PriceCheckDto"
          }
        },
        "additionalProperties": false
      },
      "PriceHistoryDto": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "integer",
            "format": "int32"
          },
          "itemName": {
            "type": "string",
            "nullable": true
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceHistoryPointDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PriceHistoryPointDto": {
        "type": "object",
        "properties": {
          "datetime": {
            "type": "string",
            "format": "date-time"
          },
          "platPrice": {
            "type": "number",
            "format": "double"
          },
          "kronoPrice": {
            "type": "number",
            "format": "double"
          },
          "isBuy": {
            "type": "boolean"
          },
          "auctioneer": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RawLogDto": {
        "type": "object",
        "properties": {
          "rawGuid": {
            "type": "string",
            "format": "uuid"
          },
          "serverName": {
            "type": "string",
            "nullable": true
          },
          "rawText": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "SalesLogDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "serverName": {
            "$ref": "#/components/schemas/ServerName"
          },
          "itemId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "item": {
            "type": "string",
            "nullable": true
          },
          "auctioneer": {
            "type": "string",
            "nullable": true
          },
          "transactionType": {
            "type": "boolean"
          },
          "platPrice": {
            "type": "number",
            "format": "double"
          },
          "kronoPrice": {
            "type": "number",
            "format": "double"
          },
          "datetime": {
            "type": "string",
            "format": "date-time"
          },
          "rawGuid": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SalesLogDtoPagedResultDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SalesLogDto"
            },
            "nullable": true
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "singleItem": {
            "type": "boolean"
          },
          "singleItemId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ServerName": {
        "enum": [
          0,
          1,
          2,
          3,
          4,
          5
        ],
        "type": "integer",
        "format": "int32"
      }
    }
  }
}